 {
-	struct ipu7_psys *psys = dev_get_drvdata(dev);
-	unsigned long flags;
-	int ret = 0;
-
-	spin_lock_irqsave(&psys->ready_lock, flags);
-	if (psys->ready)
-		ret = -EBUSY;
-	spin_unlock_irqrestore(&psys->ready_lock, flags);
-
-	return ret;
+	/*
+	 * Original returned -EBUSY whenever psys->ready was set, blocking
+	 * s2idle suspend after any camera use. Force the same teardown as
+	 * runtime PM suspend instead. Companion to staging ipu7 pci_remove
+	 * ordering fix which prevents find_iova NULL deref on MMU cleanup.
+	 */
+	return psys_runtime_pm_suspend(dev);
 }
 
